<UserControl x:Class="MehmetMusic.Views.MusicApp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MehmetMusic.Views"
             mc:Ignorable="d" 
             Width="950" Height="600">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Bilder/background.jpg"
                        Opacity="0.5"
                        Stretch="UniformToFill"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0"
                    Grid.Column="0">
            <TextBlock Text="Wilkommen:" FontSize="15" Padding="15" />
            <TextBlock Text="Mehmet Demirayak" FontSize="13" 
                   TextWrapping="Wrap"
                       Padding="15"/>
        </StackPanel>

        <StackPanel Orientation='Horizontal' Grid.Row="0"
                    Grid.Column="1"
                    Margin="55,0,0,0">
            <Button Content="Profil" 
                    Style="{StaticResource BaseButtonStyle2}" 
                    Margin="0,0,20,0"
                    VerticalAlignment="Top"
                    />
            <Button Content="Logout" Style="{StaticResource BaseButtonStyle2}" 
                    VerticalAlignment="Top"/>
        </StackPanel>

        <StackPanel Orientation='Horizontal' Grid.Row="0"
               Grid.Column="2"
                    Margin="30,0,0,0">
            <ComboBox Style="{StaticResource ComboBoxRound2}" 
                      Width="100"
                      Height="30"
                      Margin="10,0,0,0"/>
            <TextBox Style="{StaticResource NoBackgroundTextBox}" 
                     Width="200"
                     Height="25"
                     VerticalAlignment="Center"
                     TextAlignment="Left"
                     FontWeight="Bold"
                     Margin="20,0,0,0"
                     />
            <Button Content="Search"
                    Style="{StaticResource BaseButtonStyle2}" 
                    Margin="20,0,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="0"
                 Grid.ColumnSpan="2"
                 Grid.RowSpan="2"
                 Background="White"
                 Margin="50,50,180,250">

        </ListBox>

        <ListBox Grid.Row="1" Grid.Column="2"
                 Grid.ColumnSpan="2"
                 Grid.RowSpan="2"
                 Margin="10,30,20,200"
                 Background="White">
            
        </ListBox>

        <StackPanel Grid.Row="2" Grid.Column="2" 
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <Button Width="50" Height="50" Margin="10,0,10,0" >
                <Image Source="/Bilder/arrow_back.png"/>
            </Button>
            <Button Width="50" Height="50" Margin="0,0,10,0" >
                <Image Source="/Bilder/play_arrow.png"/>
            </Button>
            <Button Width="50" Height="50" Margin="0,0,0,0" >
                <Image Source="/Bilder/arrow_forward.png"/>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
            <Label Content="-"
                   FontSize="55"
                   FontWeight="Bold"
                   Margin="0,0,10,20"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Foreground="Black"
                   Background="Transparent"/>
            <Slider Width="150"
                    
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    />
            <Label Content="+"
                    FontSize="55"
                    FontWeight="Bold"
                    Margin="0,0,10,20"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Foreground="Black"
                    Background="Transparent"/>
        </StackPanel>
        
    </Grid>
</UserControl>
