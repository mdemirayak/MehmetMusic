<UserControl x:Class="MehmetMusic.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MehmetMusic.Views" 
             xmlns:components="clr-namespace:MehmetMusic.Components"
             mc:Ignorable="d">


    <Grid>
      
        <Border CornerRadius="50"  Opacity="0.35">
            <Border.Background>
                <ImageBrush ImageSource="/Bilder/background-login.jpg"
                        Stretch="UniformToFill"/>
            </Border.Background>
        </Border>

      
        <Border CornerRadius="50" BorderThickness="3" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Login"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="20,0,0,0"
                       FontSize="15"
                       FontWeight="Bold"
                       Grid.Column="0"/>
                </Grid>

                <StackPanel Grid.Row="1" 
                            Orientation="Vertical" 
                            Width="250"
                            Margin="0,35,0,50">

                    <Image Source="/Bilder/logo.jpg" 
                           Width="75"
                           Height="75"/>

                    <TextBlock Text="Mehmet Music"
                          Background="Black"
                          Foreground="White"
                          FontStyle="Oblique" 
                          TextAlignment="Center" 
                          FontFamily="Segoe Script" 
                          Width="100"     
                        />


                    <TextBox FontSize="13"
                             Foreground="Black"
                             FontWeight="Heavy"
                             Margin="0,5,0,0"
                             BorderThickness="0,0,0,1"
                             Height="28"
                             VerticalAlignment="Center"
                             Padding="25,0,0,0"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Background>
                            <ImageBrush ImageSource="/Bilder/user.png"
                                        Stretch="Uniform"
                                        AlignmentX="Left"
                                        />
                        </TextBox.Background>
                    </TextBox>

                    <TextBlock Text="Password"
                               FontSize="12"
                               FontWeight="Heavy"
                               Foreground="Black"
                               Margin="0,15,0,0"/>


                    <components:BindablePasswordBox
                        Password="{Binding Password,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}"
                        />






                    <StackPanel Orientation="Horizontal" Margin="0,50,0,0" >
                        <Button Margin="15" Content="Login" 
                                Style="{StaticResource BaseButtonStyle}" 
                                Command="{Binding ShowMusicAppCommand}"/>
                        <Button Content="Registration" 
                                Style="{StaticResource BaseButtonStyle}" 
                                Command="{Binding RegistrationCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>


</UserControl>
