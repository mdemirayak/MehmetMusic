<Window x:Class="MehmetMusic.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MehmetMusic"
        xmlns:views="clr-namespace:MehmetMusic.Views"
        xmlns:vms="clr-namespace:MehmetMusic.ViewModels"
        mc:Ignorable="d"
        Title="Mehmet Music"
        WindowStartupLocation="CenterScreen"
        >

    <Grid>
        <!-- <views:LoginView /> -->
        <Grid.Resources>
            <DataTemplate DataType="{x:Type vms:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:MusicAppViewModel}">
                <views:MusicApp/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vms:RegistrationViewModel}">
                <views:RegistrationView/>
            </DataTemplate>
        </Grid.Resources>

        <ContentControl Content="{Binding Content}" />

    </Grid>
    
</Window>





